# Public browser/mobile configuration; use your project values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# SERVER ONLY. Replace through your secret manager; never commit a real .env.
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
PGSSLROOTCERT=/absolute/path/to/your/supabase-ca.crt
PGSSLMODE=verify-full
